# Bloco do BI Caatinga, importado pelo Caddyfile do Caddy da VM Oracle (~/caddy/, desde 24/11/2026).
# O host vem da variável BI_HOST (environment em ~/caddy/docker-compose.yml); aceita vários nomes separados por vírgula.
# Usuário e hash bcrypt vêm de ~/.agentes-segredos/bi-caddy.env (env_file, 600): BI_USER e BI_HASH.
{$BI_HOST} {
	basic_auth {
		{$BI_USER} {$BI_HASH}
	}
	root * /srv/bi-caatinga
	# Bibliotecas versionadas por pasta/arquivo: cache de 30 dias
	@vendor path /vendor/*
	header @vendor Cache-Control "private, max-age=2592000, immutable"
	# Dados: o BI pede com ?v=<hash do manifest>, então podem ficar 30 dias em cache
	@dados {
		path /data/*
		query v=*
	}
	header @dados Cache-Control "private, max-age=2592000"
	# manifest, HTML e JS: sempre revalidar (troca de versão é imediata)
	@resto not path /vendor/*
	header @resto ?Cache-Control "no-cache"
	@wasm path *.wasm
	header @wasm Content-Type application/wasm
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	# Feedback (seção 10): receptor no host da VM, atrás da mesma senha. host.docker.internal aponta para o
	# gateway da rede caddy_default (extra_hosts no compose), onde o receptor escuta (BIND).
	handle /api/feedback* {
		request_body {
			max_size 22MB
		}
		reverse_proxy host.docker.internal:8090
	}
	# Arquivos .gz gerados no envio (publicar_vm.sh): nada é comprimido na hora (VM pequena)
	file_server {
		precompressed gzip
	}
}
