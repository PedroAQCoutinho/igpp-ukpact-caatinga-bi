# Trecho a incluir DENTRO do bloco {$BI_HOST} de deploy/caddy-bi.caddy, antes do file_server.
# Fica atrás do mesmo basic_auth do BI. O host do receptor depende de como o container do Caddy
# alcança o host da VM (ex.: extra_hosts "host.docker.internal:host-gateway" no compose).
handle /api/feedback* {
	request_body {
		max_size 22MB
	}
	reverse_proxy host.docker.internal:8090
}
# Anexos dos feedbacks (print e áudio), para os links das issues. Monte ~/feedback/bi-caatinga no container
# do Caddy, só leitura, em /srv/feedback (ex.: volume "/home/opc/feedback/bi-caatinga:/srv/feedback:ro").
# Só arquivos de anexo; feedback.json, issue.json e transcricao.json não são servidos.
handle_path /feedback-arquivos/* {
	@anexo path_regexp ^/[0-9]{8}-[0-9]{6}-[0-9a-f]{6}/(captura|audio)\.(png|jpg|webp|webm|ogg|mp4|m4a|mp3|wav)$
	handle @anexo {
		root * /srv/feedback
		header Cache-Control "private, max-age=3600"
		file_server
	}
	respond 404
}
